# ── Workspace Configuration ────────────────────────────────────────────────────
# Path to the project workspace where `agy run` will be invoked.
# Leave empty to use the directory from which main.py is launched.
AGY_WORKSPACE=

# ── Whisper Settings (only used when --whisper flag is passed) ─────────────────
# Model size: tiny (39M) | base (74M) | small (244M) | medium (769M) | large (1.5GB)
# Larger models are more accurate but slower on CPU.
AGY_MODEL=base

# ── Enable local faster-whisper by default (set to "1" to skip --whisper flag) ──
AGY_USE_WHISPER=0
